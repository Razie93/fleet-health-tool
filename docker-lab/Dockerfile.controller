FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends     ansible openssh-client ca-certificates     && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY controller-entrypoint.sh /usr/local/sbin/lab-controller
RUN chmod 755 /usr/local/sbin/lab-controller
WORKDIR /work
ENTRYPOINT ["/usr/local/sbin/lab-controller"]
