FROM ubuntu:24.04
ENV container=docker
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends     systemd systemd-sysv openssh-server sudo python3 python3-apt     rsyslog iproute2 procps ca-certificates     && apt-get clean && rm -rf /var/lib/apt/lists/*     && useradd --create-home --shell /bin/bash ansible     && install -d -m 700 -o ansible -g ansible /home/ansible/.ssh     && printf 'ansible ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/ansible-lab     && chmod 440 /etc/sudoers.d/ansible-lab     && printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n' > /etc/ssh/sshd_config.d/10-lab-auth.conf     && mkdir -p /etc/fail2ban/jail.d     && printf '[sshd]\nbackend = systemd\n' > /etc/fail2ban/jail.d/20-lab-journal.conf     && rm -f /etc/ssh/ssh_host_*     && systemctl enable ssh rsyslog     && systemctl set-default multi-user.target
COPY target-entrypoint.sh /usr/local/sbin/lab-entrypoint
RUN chmod 755 /usr/local/sbin/lab-entrypoint
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/usr/local/sbin/lab-entrypoint"]
